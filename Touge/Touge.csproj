<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- eigenes Icon (Tools/Icon/make_icon.py), landet in Touge.exe -->
        <ApplicationIcon>..\Tools\Icon\icon.ico</ApplicationIcon>
        <!-- Windows-Release (Tools/publish.sh): ohne Konsolenfenster, Ausgabe dann nur in touge.log -->
        <OutputType Condition="'$(Configuration)' == 'Release' And $(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- Übersetzungen der Story (Story/Translation): texts/*.tl (gepackt, Tools/texts.sh), landen neben dem Programm -->
    <ItemGroup>
        <None Include="..\texts\*.tl" Link="Translations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Touge.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Kansei\Kansei.csproj"/>
        <ProjectReference Include="..\Kansei.Physics\Kansei.Physics.csproj"/>
        <ProjectReference Include="..\Touge.Formats\Touge.Formats.csproj"/>
    </ItemGroup>

</Project>
