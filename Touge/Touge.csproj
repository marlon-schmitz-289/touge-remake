<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Tools/package.sh for Windows: a GUI exe, no console window behind the game -->
        <OutputType Condition="'$(TougeGui)' == 'true'">WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Kansei\Kansei.csproj"/>
        <ProjectReference Include="..\Kansei.Physics\Kansei.Physics.csproj"/>
        <ProjectReference Include="..\Touge.Formats\Touge.Formats.csproj"/>
    </ItemGroup>

</Project>
