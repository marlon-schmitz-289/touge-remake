<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.SDL" Version="2.23.0"/>
        <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0"/>
        <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1"/>
        <ProjectReference Include="..\Penelope\Penelope.csproj"/>
        <InternalsVisibleTo Include="Touge.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PenelopeShader Include="Shaders\**\*.vert"/>
        <PenelopeShader Include="Shaders\**\*.frag"/>
        <PenelopeShaderInclude Include="Shaders\**\*.glsl"/>
    </ItemGroup>

    <Import Project="..\Penelope\Penelope.targets"/>

</Project>
