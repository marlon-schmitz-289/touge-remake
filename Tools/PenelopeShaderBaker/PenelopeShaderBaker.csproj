<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>PenelopeShaderBaker</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- Build-time tool: compiles GLSL→SPIR-V (glslang) then cross-translates to GLSL/MSL
             (SPIRV-Cross). Penelope.targets invokes this once per shader; the baked outputs
             are embedded as resources. Backends load the right pre-translated blob at runtime
             instead of running SPIRV-Cross on every CreateShader. -->
        <PackageReference Include="glslang.net" Version="1.2.0"/>
        <PackageReference Include="SPIRV-Cross.NET" Version="1.0.1"/>
    </ItemGroup>

</Project>
